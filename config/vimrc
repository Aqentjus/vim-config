" Standalone loader. The checkout is not needed after installation.
set nocompatible
set encoding=utf-8
let g:vim_config_home = empty($VIM_CONFIG_HOME) ? expand('~/.vim-config') : $VIM_CONFIG_HOME
let g:vim_config_home = substitute(fnamemodify(g:vim_config_home, ':p'), '\\', '/', 'g')
let g:vim_config_home = substitute(g:vim_config_home, '/$', '', '')
let &runtimepath = escape(g:vim_config_home, ',') . ',' . &runtimepath
" Do not add the private directory to packpath: old CoC installs stay opt-in.
for s:module in ['options', 'theme', 'explorer', 'icons', 'search', 'clipboard',
      \ 'terminal', 'runner', 'completion', 'help', 'doctor', 'extensions']
  execute 'source ' . fnameescape(g:vim_config_home . '/core/' . s:module . '.vim')
endfor
unlet s:module
" Personal mappings/options win; feature setup reads them afterward.
if filereadable(g:vim_config_home . '/local.vim')
  execute 'source ' . fnameescape(g:vim_config_home . '/local.vim')
endif
call VimConfigCompletionSetup()
